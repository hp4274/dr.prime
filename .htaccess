# ==========================================================================
# MIME TYPES - Ensure correct Content-Type headers
# Hostinger (Apache) may not serve JS/CSS with proper MIME types by default
# ==========================================================================
<IfModule mod_mime.c>
    AddType text/javascript .js
    AddType text/css .css
    AddType image/svg+xml .svg
    AddType image/png .png
    AddType image/jpeg .jpg .jpeg
    AddType image/webp .webp
    AddType font/woff2 .woff2
    AddType font/woff .woff
    AddType font/ttf .ttf
    AddType application/font-woff .woff
    AddType application/font-woff2 .woff2
    AddType video/mp4 .mp4
</IfModule>

# ==========================================================================
# PREVENT CACHING ISSUES DURING DEVELOPMENT
# Remove or increase max-age values for production
# ==========================================================================
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# ==========================================================================
# ENABLE GZIP COMPRESSION
# (Commented out because Hostinger's native server compression conflicts 
# with mod_deflate, causing CSS and JS files to be truncated)
# ==========================================================================
# <IfModule mod_deflate.c>
#     AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript
# </IfModule>

# ==========================================================================
# PREVENT DIRECTORY LISTING
# ==========================================================================
Options -Indexes

# ==========================================================================
# UTF-8 ENCODING
# ==========================================================================
AddDefaultCharset UTF-8
